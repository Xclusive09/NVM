// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet             Wallet?
  paymentTransactions PaymentTransaction[]
  distributionBatches DistributionBatch[]
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model WalletTransaction {
  id          String                  @id @default(uuid())
  walletId    String
  type        WalletTransactionType
  amount      Decimal                 @db.Decimal(15, 2)
  balanceBefore Decimal               @db.Decimal(15, 2)
  balanceAfter  Decimal               @db.Decimal(15, 2)
  status      WalletTransactionStatus @default(PENDING)
  description String?
  reference   String?                 @unique
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  PAYSTACK
  MONEYFIRE
}

model PaymentTransaction {
  id            String          @id @default(uuid())
  userId        String
  amount        Decimal         @db.Decimal(15, 2)
  reference     String          @unique
  provider      PaymentProvider
  providerRef   String?
  status        PaymentStatus   @default(PENDING)
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Network {
  MTN
  AIRTEL
  GLO
  NINE_MOBILE
}

enum ValueType {
  AIRTIME
  DATA
}

enum BatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

model DistributionBatch {
  id           String      @id @default(uuid())
  userId       String
  network      Network
  valueType    ValueType
  amount       Decimal?    @db.Decimal(15, 2)  // For airtime
  dataPlanId   String?     // For data plans
  dataPlanName String?     // For display
  totalCost    Decimal     @db.Decimal(15, 2)
  recipientCount Int
  successCount Int         @default(0)
  failedCount  Int         @default(0)
  status       BatchStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients  RecipientTransaction[]
}

enum RecipientStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

model RecipientTransaction {
  id            String          @id @default(uuid())
  batchId       String
  phoneNumber   String
  amount        Decimal         @db.Decimal(15, 2)
  status        RecipientStatus @default(PENDING)
  providerRef   String?
  errorMessage  String?
  processedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  batch DistributionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model DataPlan {
  id        String   @id @default(uuid())
  network   Network
  name      String
  code      String   // Provider-specific plan code
  price     Decimal  @db.Decimal(15, 2)
  validity  String   // e.g., "30 days", "7 days"
  dataSize  String   // e.g., "1GB", "500MB"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([network, code])
}
